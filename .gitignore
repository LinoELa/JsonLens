# Dependencias instaladas por el frontend
node_modules/
bower_components/

# Salidas generadas al compilar o previsualizar
dist/
dist-ssr/
build/
coverage/

# Caches y metadatos de herramientas
.cache/
.eslintcache
.parcel-cache/
.next/
vite.config.timestamp*
*.tsbuildinfo

# Variables de entorno y overrides locales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Logs y archivos de ejecucion temporal
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.pid.lock
*.seed

# Temporales e historiales locales
tmp/
temp/
*.tmp
*~
.node_repl_history
**/*.backup.*
**/*.back.*

# Configuracion de editores y del IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace

# Archivos generados por el sistema operativo
.DS_Store
.DS_*
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# Copias auxiliares de lockfiles del gestor de paquetes
package-lock.json.*
yarn.lock.*
pnpm-lock.yaml.*

# Recursos de diseno que no deben versionarse
psd
thumb
sketch
